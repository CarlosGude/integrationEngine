{
    "source": {
        "directories": ["src"],
        "excludes": [
            "Bundle",
            "Core/Contract/Action/ActionBodyInterface.php",
            "Core/Contract/Action/ActionContextInterface.php",
            "Core/Contract/Client/ClientInterface.php",
            "Core/Contract/Client/RequestHeadersInterface.php",
            "Core/Contract/Response/ResponseInterface.php",
            "Core/Port/CachePort.php",
            "Core/Port/ConfigPort.php",
            "Core/Registry/IntegrationName.php"
        ]
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testdox",
    "minMsi": 85,
    "minCoveredMsi": 95,
    "mutators": {
        "@default": true,
        "UnwrapArrayMap": false,
        "UnwrapArrayFilter": false,
        "Throw_": {
            "ignore": [
                "IntegrationEngine\\Core\\Contract\\Action\\AbstractAction",
                "IntegrationEngine\\Core\\IntegrationEngine"
            ]
        },
        "ProtectedVisibility": {
            "ignore": [
                "IntegrationEngine\\Infrastructure\\Http\\ResolvesAuthHeaders"
            ]
        },
        // The following ignores are documented equivalent mutants (see
        // docs/QUALITY.md "Equivalent mutants" for the reasoning behind
        // each one) — not thresholds relaxed to make CI pass.
        "TrueValue": {
            "ignore": [
                // Hash-set markers checked only via isset(); the stored
                // boolean value itself is never read, so true vs false is
                // unobservable.
                "IntegrationEngine\\Core\\Batch\\BatchTokenRetry::prepareWithToken",
                "IntegrationEngine\\Core\\Batch\\BatchTokenRetry::plan",
                "IntegrationEngine\\Infrastructure\\Adapter\\YamlConfigAdapter::resolvePathPlaceholders"
            ]
        },
        "CastFloat": {
            "ignore": [
                // fromArray()'s preceding is_int/is_float/ctype_digit guard
                // already rules out every value for which casting to float
                // (vs. leaving it as-is) changes the "< 0" outcome.
                "IntegrationEngine\\Core\\Contract\\Auth\\DynamicAuthorizationConfig::fromArray"
            ]
        },
        "ReturnRemoval": {
            "ignore": [
                // dispatchBatch([]) falls through to the same [] result via
                // its own empty-array loops either way — the early return
                // is a micro-optimisation, not a behaviour branch.
                "IntegrationEngine\\Core\\IntegrationEngine::dispatchBatch"
            ]
        },
        "CastString": {
            "ignore": [
                // Only a fractional-float $connection — not a realistic
                // tenant-id shape per this method's own docs — would expose
                // the missing cast, via PHP's own float-to-int array-key
                // truncation.
                "IntegrationEngine\\Core\\IntegrationEngine::resolveConnection"
            ]
        },
        "IncrementInteger": {
            "ignore": [
                // Sub-1% precision on a wall-clock duration needs an
                // injectable clock to pin down deterministically; the
                // surrounding order-of-magnitude is covered by
                // TracingMiddlewareTest instead. Tracked in docs/QUALITY.md.
                "IntegrationEngine\\Infrastructure\\Debug\\TracingMiddleware::process",
                "IntegrationEngine\\Infrastructure\\Debug\\TracingMiddleware::processMany"
            ]
        },
        "DecrementInteger": {
            "ignore": [
                "IntegrationEngine\\Infrastructure\\Debug\\TracingMiddleware::process",
                "IntegrationEngine\\Infrastructure\\Debug\\TracingMiddleware::processMany"
            ]
        }
    },
    "logs": {
        "text": "var/infection/infection.log",
        "html": "var/infection/infection.html",
        "summary": "var/infection/infection-summary.log",
        "perMutator": "var/infection/infection-per-mutator.md"
    },
    "phpUnit": {
        "configDir": "."
    }
}
