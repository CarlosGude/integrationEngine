{
    "source": {
        "directories": ["src"],
        "excludes": [
            "Bundle",
            "Core/Contract/Action/ActionBodyInterface.php",
            "Core/Contract/Action/ActionContextInterface.php",
            "Core/Contract/Client/ClientInterface.php",
            "Core/Contract/Client/RequestHeadersInterface.php",
            "Core/Contract/Response/ResponseInterface.php",
            "Core/Port/CachePort.php",
            "Core/Port/ConfigPort.php",
            "Core/Registry/IntegrationName.php"
        ]
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testdox",
    "minMsi": 85,
    "minCoveredMsi": 95,
    "mutators": {
        "@default": true,
        "UnwrapArrayMap": false,
        "UnwrapArrayFilter": false,
        "Throw_": {
            "ignore": [
                "IntegrationEngine\\Core\\Contract\\Action\\AbstractAction",
                "IntegrationEngine\\Core\\IntegrationEngine",
                // AbstractMapper::map() is final and repeats this very check,
                // throwing the same exception with the same arguments, so
                // removing this throw changes nothing observable.
                "IntegrationEngine\\Core\\Dispatch\\ResponseBuilder::applyMapper::41"
            ]
        },
        "ProtectedVisibility": {
            "ignore": [
                "IntegrationEngine\\Infrastructure\\Http\\ResolvesAuthHeaders"
            ]
        },
        // The following ignores are documented equivalent mutants (see
        // docs/advanced/QUALITY.md "Equivalent mutants" for the reasoning
        // each one) — not thresholds relaxed to make CI pass.
        "TrueValue": {
            "ignore": [
                // Hash-set markers checked only via isset(); the stored
                // boolean value itself is never read, so true vs false is
                // unobservable.
                "IntegrationEngine\\Core\\Batch\\BatchTokenRetry::prepareWithToken",
                "IntegrationEngine\\Core\\Batch\\BatchTokenRetry::plan",
                "IntegrationEngine\\Infrastructure\\Adapter\\YamlConfigAdapter::resolvePathPlaceholders"
            ]
        },
        "CastFloat": {
            "ignore": [
                // fromArray()'s preceding is_int/is_float/ctype_digit guard
                // already rules out every value for which casting to float
                // (vs. leaving it as-is) changes the "< 0" outcome.
                "IntegrationEngine\\Core\\Contract\\Auth\\DynamicAuthorizationConfig::fromArray"
            ]
        },
        "ReturnRemoval": {
            "ignore": [
                // dispatch([]) falls through to the same [] result via its own
                // empty-array loops either way — the early return is a
                // micro-optimisation, not a behaviour branch. Pinned to the
                // line so the method's real return stays mutated.
                "IntegrationEngine\\Core\\Dispatch\\BatchDispatcher::dispatch::36"
            ]
        },
        "CastString": {
            "ignore": [
                // Only a fractional-float $connection — not a realistic
                // tenant-id shape per this method's own docs — would expose
                // the missing cast, via PHP's own float-to-int array-key
                // truncation.
                "IntegrationEngine\\Core\\Dispatch\\ConnectionResolver::resolve"
            ]
        },
        "LogicalNot": {
            "ignore": [
                // $this->subscribers[$eventClass][] = … creates the array by
                // itself, so the isset() guard it negates cannot change the
                // resulting state.
                "IntegrationEngine\\Core\\Lifecycle\\LifecycleEventDispatcher::subscribe"
            ]
        },
        "LessThanOrEqualTo": {
            "ignore": [
                // A signature exactly as long as its prefix leaves an empty
                // hash, which hash_equals() rejects anyway — "<" and "<=" both
                // end in a false return.
                "IntegrationEngine\\Core\\Webhook\\HmacSha256SignatureVerifier::verify"
            ]
        },
        "LogicalOr": {
            "ignore": [
                // With no provided hashes the loop below returns false anyway,
                // and a non-numeric timestamp casts to 0, which is outside any
                // sane tolerance — so "||" and "&&" agree on every input this
                // verifier can be called with. Scoped to the method because
                // both operators sit on the same line.
                "IntegrationEngine\\Core\\Webhook\\TimestampedHmacSignatureVerifier::verify"
            ]
        },
        "CastInt": {
            "ignore": [
                // Only a non-canonical numeric timestamp ("1700000000.0",
                // " 1700000000") signs a different string with and without the
                // cast, and no provider sends one. Pinned to the line so the
                // cast feeding isWithinTolerance() stays mutated.
                "IntegrationEngine\\Core\\Webhook\\TimestampedHmacSignatureVerifier::verify::49",
                // format('U') is a numeric string: subtracting it yields the
                // same int with or without the cast.
                "IntegrationEngine\\Core\\Webhook\\TimestampedHmacSignatureVerifier::isWithinTolerance"
            ]
        },
        "IncrementInteger": {
            "ignore": [
                // Sub-1% precision on a wall-clock duration needs an
                // injectable clock to pin down deterministically; the
                // surrounding order-of-magnitude is covered by
                // TracingMiddlewareTest instead. Tracked in
                // docs/advanced/QUALITY.md.
                "IntegrationEngine\\Infrastructure\\Debug\\TracingMiddleware::process",
                "IntegrationEngine\\Infrastructure\\Debug\\TracingMiddleware::processMany",
                // Same seconds-to-milliseconds conversion, this time for the
                // durations carried by the lifecycle events.
                "IntegrationEngine\\Core\\IntegrationEngine::send::111",
                "IntegrationEngine\\Core\\IntegrationEngine::send::123",
                "IntegrationEngine\\Core\\IntegrationEngine::send::125",
                "IntegrationEngine\\Core\\IntegrationEngine::send::137",
                "IntegrationEngine\\Core\\IntegrationEngine::send::148"
            ]
        },
        "DecrementInteger": {
            "ignore": [
                "IntegrationEngine\\Infrastructure\\Debug\\TracingMiddleware::process",
                "IntegrationEngine\\Infrastructure\\Debug\\TracingMiddleware::processMany",
                "IntegrationEngine\\Core\\IntegrationEngine::send::111",
                "IntegrationEngine\\Core\\IntegrationEngine::send::123",
                "IntegrationEngine\\Core\\IntegrationEngine::send::125",
                "IntegrationEngine\\Core\\IntegrationEngine::send::137",
                "IntegrationEngine\\Core\\IntegrationEngine::send::148"
            ]
        }
    },
    "logs": {
        "text": "var/infection/infection.log",
        "html": "var/infection/infection.html",
        "summary": "var/infection/infection-summary.log",
        "perMutator": "var/infection/infection-per-mutator.md"
    },
    "phpUnit": {
        "configDir": "."
    }
}
